### **Widget Structure Pattern** (MANDATORY)
```dart
class ExampleScreen extends ConsumerStatefulWidget {
  // 1. CONSTANTS & STATIC VARIABLES (if any)
  static const double defaultPadding = 16.0;
  
  // 2. FINAL INSTANCE VARIABLES
  final String title;
  
  // 3. CONSTRUCTOR
  const ExampleScreen({super.key, required this.title});
  
  @override
  ConsumerState<ExampleScreen> createState() => _ExampleScreenState();
}

class _ExampleScreenState extends ConsumerState<ExampleScreen> {
  // 4. MUTABLE INSTANCE VARIABLES
  int _currentIndex = 0;
  late ScrollController _scrollController;
  
  // 5. LIFECYCLE METHODS
  @override
  void initState() {
    super.initState();
    _scrollController = ScrollController();
  }
  
  @override
  void dispose() {
    _scrollController.dispose();
    super.dispose();
  }
  
  // 6. BUILD METHOD (main UI structure only)
  @override
  Widget build(BuildContext context) {
    return Scaffold(
      body: CustomScrollView(
        slivers: [
          _buildAppBar(),
          _buildContent(),
        ],
      ),
    );
  }
  
  // 7. PRIVATE UI BUILDER METHODS (alphabetical order)
  Widget _buildAppBar() { /* ... */ }
  Widget _buildContent() { /* ... */ }
  
  // 8. PRIVATE UTILITY METHODS
  void _handleTap() { /* ... */ }
  String _formatPrice(int price) { /* ... */ }
}
```

