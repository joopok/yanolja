## 🚫 **PERFORMANCE KILLERS** (NEVER DO)

### ❌ **Memory Leak Patterns**
```dart
// ❌ FORBIDDEN: No disposal of controllers
class BadWidget extends StatefulWidget {
  @override
  _BadWidgetState createState() => _BadWidgetState();
}

class _BadWidgetState extends State<BadWidget> {
  final ScrollController _controller = ScrollController();
  
  // WRONG: No dispose method!
  @override
  Widget build(BuildContext context) {
    return ListView(controller: _controller);
  }
}

// ✅ REQUIRED: Proper disposal
class GoodWidget extends StatefulWidget {
  @override
  _GoodWidgetState createState() => _GoodWidgetState();
}

class _GoodWidgetState extends State<GoodWidget> {
  late final ScrollController _controller;
  
  @override
  void initState() {
    super.initState();
    _controller = ScrollController();
  }
  
  @override
  void dispose() {
    _controller.dispose(); // REQUIRED!
    super.dispose();
  }
  
  @override
  Widget build(BuildContext context) {
    return ListView(controller: _controller);
  }
}
```

### ❌ **Build Method Anti-patterns**
```dart
// ❌ FORBIDDEN: Heavy computation in build method
Widget build(BuildContext context) {
  // WRONG: Expensive operation on every rebuild
  final processedData = heavyDataProcessing(rawData);
  return Text(processedData);
}

// ✅ REQUIRED: Memoize expensive operations
class OptimizedWidget extends StatefulWidget {
  final List<Data> rawData;
  
  @override
  _OptimizedWidgetState createState() => _OptimizedWidgetState();
}

class _OptimizedWidgetState extends State<OptimizedWidget> {
  String? _cachedProcessedData;
  List<Data>? _lastProcessedRawData;
  
  String get processedData {
    // REQUIRED: Only recompute when data changes
    if (_lastProcessedRawData != widget.rawData) {
      _cachedProcessedData = heavyDataProcessing(widget.rawData);
      _lastProcessedRawData = widget.rawData;
    }
    return _cachedProcessedData!;
  }
  
  @override
  Widget build(BuildContext context) {
    return Text(processedData);
  }
}
```

