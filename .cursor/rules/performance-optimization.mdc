    return DropdownButton<String>(
      value: selectedRegion,
      onChanged: (value) => ref.read(selectedRegionProvider.notifier).state = value,
      items: regions.map((region) => DropdownMenuItem(/*...*/)).toList(),
    );
  },
)
```

### **Riverpod Performance Patterns**
```dart
// ✅ REQUIRED: Selective watching with select
Widget build(BuildContext context) {
  // REQUIRED: Only rebuild when specific field changes
  final isLoading = ref.watch(
    accommodationStateProvider.select((state) => state.isLoading),
  );
  
  return isLoading 
    ? const CircularProgressIndicator()
    : const AccommodationList();
}

// ✅ REQUIRED: Family providers for parameterized data
final accommodationsByRegionProvider = Provider.family<List<Accommodation>, String>(
  (ref, region) {
    final allAccommodations = ref.watch(accommodationListProvider);
    return allAccommodations.where((acc) => acc.region == region).toList();
  },
);
```

